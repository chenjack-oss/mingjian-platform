# ===== 明辨平台 · 环境变量模板 =====
# 复制为 .env 后填写。.env 已在 .gitignore 中，不要提交。

# ---------- 服务 ----------
MJ_PORT=8000
# prod/production 会触发 fail-closed 策略：未配 MJ_CORS_ORIGINS 时**拒绝所有跨源**
# （而不是放行所有来源）。本地开发留空即可。
MJ_ENV=
# 生产必须显式指定来源，逗号分隔；不配则放行所有来源（启动时会打警告）
MJ_CORS_ORIGINS=http://<你的服务器IP或域名>
# 日志级别：DEBUG/INFO/WARNING/ERROR。
# 诊断信息统一走 logging（带时间戳/级别/模块名），不再用 print 刷屏。
MJ_LOG_LEVEL=INFO

# ---------- 数据库 ----------
# 生产（Postgres）：
# MJ_DB_URL=postgresql+psycopg://mingjian:改成强密码@postgres:5432/mingjian
# 本地（SQLite，无需装数据库）：
MJ_DB_URL=sqlite:///./.data/mingjian.db
MJ_DB_ECHO=0

# ---------- LangGraph 检查点 ----------
# auto：Postgres 则用 PostgresSaver，否则回退内存并如实上报
MJ_CHECKPOINTER=auto

# ---------- 身份认证 ----------
# 管理接口（创建用户/签发 Key）的令牌；不配则管理接口全部 403
MJ_ADMIN_TOKEN=改成一长串随机值
# 是否允许匿名访问。生产必须 0
MJ_ALLOW_ANONYMOUS=0

# ---------- 模型（OpenAI 兼容）----------
MJ_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MJ_LLM_API_KEY=
MJ_LLM_MODEL=qwen-max
# direct 档（零工具最快路径）专用快模型；留空则沿用 MJ_LLM_MODEL
MJ_LLM_MODEL_FAST=qwen-flash
MJ_LLM_TIMEOUT=60

# ---------- 熔断与降级（P9）----------
# 端点抖动时"每个请求都等满超时"是最糟策略：用户看到全员卡死，后端还在被无效请求冲击
MJ_LLM_MAX_RETRIES=2
MJ_LLM_CIRCUIT_ENABLED=1
# 滑动窗口内累计失败多少次开闸
MJ_LLM_CIRCUIT_THRESHOLD=5
MJ_LLM_CIRCUIT_WINDOW_SEC=60
# 开闸后冷却多久；到期转半开，只放行一个探测请求
MJ_LLM_CIRCUIT_COOLDOWN_SEC=30
# 备用模型：主模型熔断后切过去。留空则用 MJ_LLM_MODEL_FAST，再没有就只给兜底话术
MJ_LLM_FALLBACK_MODEL=

# ---------- 上下文 ----------
MJ_CONTEXT_TURNS=8
MJ_CONTEXT_MSG_CHARS=1200

# ---------- 配额（P1 只记帐，P2 做硬限流）----------
MJ_QUOTA_SEARCHES_PER_DAY=50
MJ_QUOTA_MESSAGES_PER_DAY=200

# ---------- Redis（P3：一个组件三种用途：缓存 / 限流 / Celery broker）----------
# 留空 = 三项能力全部关闭，主链路不受任何影响（/health 会如实报 redis=off）
# 填了则用 0 号库做缓存与限流，1 号库做 Celery broker（分库是为了清缓存时不误伤队列）
MJ_REDIS_URL=redis://redis:6379/0
MJ_REDIS_TIMEOUT=0.5
# 故障冷却（秒）：Redis 挂掉后 N 秒内不再重连，避免超时叠加到每个请求上
MJ_REDIS_COOLDOWN=10

# 语义缓存
MJ_CACHE_ENABLED=1
MJ_CACHE_TTL=3600
# TTL 抖动（百分比）：防同一批 key 同时过期造成的雪崩
MJ_CACHE_JITTER_PCT=20
# 缓存作用域：改这个值即可让全部缓存失效（P4 接入知识库后换成 kb_version）
MJ_CACHE_SCOPE=v1
# 只缓存零工具的回答（带检索/写文件的结果有时效性与副作用，不缓存）
MJ_CACHE_ZERO_TOOL_ONLY=1
# 上面设为 0 后，调用过工具的回答用这个更短的 TTL（秒）—— 检索结果会变，1 小时太长
MJ_CACHE_TTL_WITH_TOOLS=300

# 令牌桶限流（按 user_id 维度，不是按 IP）
MJ_RATE_ENABLED=1
MJ_RATE_CAPACITY=20
MJ_RATE_REFILL_PER_SEC=2

# ---------- 可观测（P3：Langfuse）----------
# 三项（enabled + public + secret）全配齐才启用，否则整体 no-op，主链路不受影响
# 自托管时把 MJ_LANGFUSE_HOST 改成自己的地址
MJ_LANGFUSE_ENABLED=1
MJ_LANGFUSE_PUBLIC_KEY=
MJ_LANGFUSE_SECRET_KEY=
MJ_LANGFUSE_HOST=https://cloud.langfuse.com
MJ_LANGFUSE_SAMPLE_RATE=1
MJ_LANGFUSE_ENVIRONMENT=production
MJ_LANGFUSE_FLUSH_AT=20
MJ_LANGFUSE_FLUSH_INTERVAL=5
MJ_LANGFUSE_TIMEOUT=5
# Langfuse 缺席时的本地兜底（P8）：把每轮关键指标落成 JSONL，一行一轮。
# 没有它，没配 Langfuse 就等于完全没有 trace，无法复盘"这次为什么慢"。
MJ_TRACE_LOCAL=1
MJ_TRACE_DIR=./.data/traces

# ---------- Agentic RAG 服务化接入（P7）----------
# 留空 = 不启用 HTTP 通道，kb-analyst 回落到 MCP stdio（串行，并发上限 1）
# 填了 = 走 HTTP 服务（服务端 CapacityLimiter 4，客户端并发闸门必须 ≤ 4）
MJ_AGENTIC_RAG_URL=http://rag:8000
# 客户端超时必须 **小于** 服务端的 120s，否则拿不到服务端 504，分不清"真慢"和"断网"
MJ_AGENTIC_RAG_TIMEOUT=110
MJ_AGENTIC_RAG_CONNECT_TIMEOUT=5
MJ_AGENTIC_RAG_CONCURRENCY=4

# ---------- 异步任务（P3：Celery）----------
# 留空则自动用 Redis 的 1 号库；完全没配 Redis 时回落 memory://（仅供本地 eager 单测）
MJ_CELERY_BROKER=
# eager：任务在当前进程内联执行。没配 Redis 时自动为 1，生产填了 Redis 后为 0
MJ_CELERY_EAGER=0
# research 档默认转异步（实测 125 秒，同步必超时）
MJ_ASYNC_AUTO_RESEARCH=1
MJ_TASK_SOFT_TIME_LIMIT=600
MJ_TASK_TIME_LIMIT=660
# 必须 > 任务最长耗时，否则任务会被 broker 重复投递
MJ_TASK_VISIBILITY_TIMEOUT=900
# running 状态超过这个秒数没更新 → 标记 stalled（worker 大概已被 kill）
MJ_TASK_STALL_SEC=900
# 幂等窗口（秒）：已终态的任务在这个窗口内仍可被重复提交命中
MJ_TASK_DEDUPE_WINDOW=120

# ---------- MCP（P5：业务系统 + 知识库集成）----------
# 关闭时工具集为空，主链路不受影响（/health 如实报 mcp=0）
MJ_MCP_ENABLED=1
# 要挂哪些 MCP Server，逗号分隔。默认只挂业务系统。
# 加 rag 会把知识库工具（kb_search/kb_lookup/kb_stats）一起挂上 —— 见下方说明
MJ_MCP_SERVERS=business
# 工具白名单，留空 = server 给多少吃多少。
# 为什么要能裁剪：实测工具从 3 个涨到 16 个，模型选错工具的概率上升，
# 所以"挂多少"必须可配，不能 server 给多少就全吃。
MJ_MCP_TOOLS=
# persistent=常驻线程复用子进程（默认，实测比每次现起快 21 倍）
# per_call=每次调用现起子进程，仅用于对照测量
MJ_MCP_SESSION=persistent
# 单次工具调用超时。kb_search 端到端 20~40s，挂了知识库就要调大。
MJ_MCP_TIMEOUT=120

# 外部 MCP Server（Agentic RAG）的启动命令。
# 为什么必须外部起：明辨要 mcp>=2.0，RAG 要 torch + FlagEmbedding，
# 两边依赖装不进同一个虚拟环境 —— 独立进程各用自己的解释器才是正解。
# 为什么用 | 分隔而不是空格：Windows 路径里几乎必然有空格，按空格切会切碎。
# MJ_MCP_RAG_CMD=D:\Agentic RAG\.venv\Scripts\python.exe|-m|mcp_rag_server
# MJ_MCP_RAG_CWD=D:\Agentic RAG

# ---------- 联网检索（豆包 Global Search）----------
# 留空则工具直接返回"不可用"，模型改用已有知识并如实说明未联网
DOUBAO_SEARCH_API_KEY=
# 每用户预算（次）。配了 Redis 时是**全局计数**（Lua 原子 check-and-consume），
# 否则退回进程内计数（多 worker 部署时实际额度 = 预算 × worker 数）
MJ_SEARCH_BUDGET=12
# 全局预算的统计窗口（秒），到期自动重置
MJ_SEARCH_BUDGET_TTL=86400

# ---------- 文件 ----------
MJ_STORAGE_ROOT=./.data/files
MJ_MAX_UPLOAD_MB=50
